# ===========================================
# Dovi V1 — Environment Variables
# ===========================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
#
# NEVER commit .env to Git.
# ===========================================

# --- AI / LLM ---
# Your API key for the LLM provider (e.g. Google Gemini, OpenAI)
AI_API_KEY=

# --- Speech-to-Text ---
# API key for the STT provider (leave blank if using a local/free provider)
STT_API_KEY=

# --- Text-to-Speech ---
# API key for the TTS provider (leave blank if using a local/free provider)
TTS_API_KEY=

